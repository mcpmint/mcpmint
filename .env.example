# Canonical public site origin (metadata, Open Graph, sitemap, robots).
# Set this to your production domain after DNS/custom domain is live.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Timeout (ms) for each local CLI/CI verification command. Default 120000.
# The public web generation API never spawns verification processes.
# MCPMINT_FULL_VERIFY_TIMEOUT_MS=120000

# --- Rate limiting ---
# Max requests per IP per 60s window for /api/generate and /api/fetch-spec.
# Default 20.
# MCPMINT_RATE_LIMIT_MAX=20

# Trust client-supplied x-real-ip for rate-limit keys. Default off — only enable
# behind a reverse proxy that overwrites this header (not needed on Vercel).
# MCPMINT_TRUST_X_REAL_IP=1

# Trust X-Forwarded-For only behind a proxy that overwrites/appends the rightmost hop.
# Vercel platform headers are trusted automatically only on Vercel.
# MCPMINT_TRUST_X_FORWARDED_FOR=1

# Optional shared rate limiter (recommended on Vercel). When both are set,
# counters live in Upstash Redis instead of per-instance memory.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Optional anonymous PostHog product analytics. The phc_ project token is public,
# not a personal API key. Set both at build time in Vercel; redeploy after changes.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EU projects: https://eu.i.posthog.com
