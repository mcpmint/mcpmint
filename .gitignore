# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
cli/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
cli/dist

# python (pypi wrapper) build artifacts
pypi/dist
**/__pycache__/
*.egg-info/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example committed for operators)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Browser test artifacts
/test-results/
/playwright-report/
