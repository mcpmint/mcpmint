{
  "name": "mcpmint-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:generator": "npm run test:generator:unit && npm run test:parsers && npm run test:api",
    "test:generator:unit": "node --test --experimental-strip-types --experimental-specifier-resolution=node src/lib/generator/*.test.ts",
    "test:parsers": "node --test --experimental-strip-types --experimental-specifier-resolution=node src/lib/parsers/*.test.ts",
    "test:api": "node --test --experimental-strip-types --experimental-specifier-resolution=node src/lib/api/*.test.ts",
    "test:workflow": "node --test --experimental-strip-types next-config.test.ts src/app/accessibility-contract.test.ts src/store/project-history.test.ts src/store/project-file.test.ts src/lib/capabilities.test.ts src/lib/spec-diff.test.ts src/lib/sandbox/*.test.ts src/lib/scanner/*.test.ts src/lib/scanner/checks/*.test.ts src/lib/analytics/*.test.ts",
    "test:cli": "node --test --experimental-strip-types cli/src/*.test.ts",
    "test:generated:full": "node --test --experimental-strip-types --experimental-specifier-resolution=node src/lib/generator/generated-full-verification.ci.ts",
    "audit:dependencies": "npm audit --audit-level=low",
    "test:production:browser": "node scripts/verify-production-browser.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.562.0",
    "next": "^16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.9",
    "posthog-js": "^1.436.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "@playwright/test": "^1.64.0",
    "axe-core": "^4.14.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "@humanfs/node": "^0.17.0",
    "fast-glob": "npm:tinyglobby@^0.2.15",
    "brace-expansion@^1.1.7": "^1.1.21",
    "brace-expansion@^2.0.2": "^2.1.7"
  }
}
